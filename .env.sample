# 필요한 값만 설정하세요. 서버는 이 파일을 자동으로 읽지 않으므로 셸 환경 변수로 넣어 주세요.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# NEWTEAM_HOST=127.0.0.1
# NEWTEAM_PORT=8000
# NEWTEAM_DATA_DIR=./backend/data
# NEWTEAM_MODE=dev               # dev | server (다른 사람이 접속하면 server)
# NEWTEAM_SANDBOX=local          # local(개발용) | docker
# NEWTEAM_DOCKER_RUNTIME=        # runsc 로 설정하면 gVisor 사용(Linux)
# NEWTEAM_DOCKER_IMAGE=python:3.12-slim
# NEWTEAM_COMMAND_TIMEOUT=60
# NEWTEAM_ALLOW_SIGNUP=0         # 1이면 누구나 회원가입
# NEWTEAM_SECURE_COOKIE=0        # HTTPS로 서비스하면 1
# NEWTEAM_SESSION_DAYS=14
